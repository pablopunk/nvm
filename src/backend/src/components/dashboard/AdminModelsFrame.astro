---
import { Card } from '../ui/card';
import { AdminModelCheck } from './AdminModelCheck';

---
<Card className="section admin-panel admin-model-config"><section>
  <div class="flex items-start justify-between gap-4">
    <h2>Models</h2>
    <AdminModelCheck client:only="react" />
  </div>
  <p class="muted">Each slot lists only models that passed a live check. Fast costs at most $2/M output, starts answering within 2 seconds with thinking off, calls tools and streams usage. Smart reasons, reads images, calls tools and streams usage. Dictation uses audio transcription.</p>
  <div class="model-routes"><slot /></div>
</section></Card>
