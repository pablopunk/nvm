---
import AdminModelsFrame from './AdminModelsFrame.astro';

const ADMIN_MODEL_ROUTE_COUNT = 6;
---
<AdminModelsFrame busy>
  {Array.from({ length: ADMIN_MODEL_ROUTE_COUNT }, () => (
    <section class="model-route-row" aria-hidden="true">
      <header class="model-route-row__header"><span class="dashboard-skeleton model-route-row__skeleton-title"></span></header>
      <div class="model-route-row__controls"><span class="dashboard-skeleton model-route-row__skeleton-control"></span></div>
      <p class="model-route-row__details"><span class="dashboard-skeleton model-route-row__skeleton-details"></span></p>
    </section>
  ))}
</AdminModelsFrame>
