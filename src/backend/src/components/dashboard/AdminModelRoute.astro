---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> { title: string; tier: 'pro' | 'free' | 'dictation' | 'decisions' }
const { title, tier, ...attributes } = Astro.props;
---
<section class="model-route-row" data-tier={tier} {...attributes}>
  <header class="model-route-row__header"><strong class="model-route-row__title">{title}</strong><span class="status" data-status role="status" aria-live="polite"></span></header>
  <div class="model-route-row__controls"><slot /></div>
  <p class="model-route-row__details muted"><slot name="details" /></p>
</section>
