---
interface Props {
  current: 'guide' | 'features' | 'api';
}

const { current } = Astro.props;
const links = [
  { id: 'guide', href: '/docs', label: 'Guide' },
  { id: 'features', href: '/docs/features', label: 'Built-in features' },
  { id: 'api', href: '/docs/api', label: 'Extension API' },
] as const;
---
<span class="docs-sidebar__section">Docs</span>
{links.map((link) => (
  <a href={link.href} aria-current={link.id === current ? 'page' : undefined}>{link.label}</a>
))}
