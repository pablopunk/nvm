---
import { ArrowDown } from '@lucide/astro';
import LandingPalette from './landing-palette/LandingPalette';
---
<section id="features" class="palette-demo" aria-labelledby="palette-demo-title">
  <div class="palette-demo__copy">
    <h2 id="palette-demo-title"><span class="palette-demo__highlight">No AI</span>? No problem.</h2>
    <p>A command palette with <strong>batteries included.</strong> Launch apps, find files, search your clipboard, and dictate.</p>
    <p class="palette-demo__cta">Go ahead and try it <ArrowDown size={17} aria-hidden="true" /></p>
  </div>
  <LandingPalette client:visible />
</section>

<style is:global>
  .palette-demo { width: 100%; max-width: 720px; margin: 0 auto; padding: 112px 24px 144px; text-align: center; }
  .palette-demo h2 { margin: 0 0 20px; font-size: clamp(28px, 3vw, 36px); line-height: 1.2; letter-spacing: -0.03em; }
  .palette-demo__copy p { max-width: 520px; margin: 0 auto 12px; color: var(--muted); font-size: 17px; line-height: 1.7; }
  .palette-demo__copy .palette-demo__cta { display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 32px; color: var(--text); font-weight: 500; line-height: 1; }
  .palette-demo__cta svg { flex: none; position: relative; top: -1.5px; }
  .palette-demo__copy strong { color: var(--text); font-weight: 600; }
  .palette-demo__highlight { color: #f4cf86; }
  @supports (background-clip: text) {
    .palette-demo__highlight { background: linear-gradient(110deg, #fff0c1, #d99739 65%, #f4d890); background-clip: text; color: transparent; }
  }
  .landing-palette { position: relative; text-align: left; }
  .landing-palette__host { min-height: 470px; }
  .landing-palette__tabs { display: flex; justify-content: center; gap: 8px; flex-wrap: wrap; margin-top: 20px; }
  .landing-palette__tabs button { display: inline-flex; align-items: center; gap: 7px; padding: 7px 14px; border: 1px solid #2a2a2a; border-radius: 999px; background: transparent; color: var(--muted); font: inherit; font-size: 13px; font-weight: 500; letter-spacing: 0.01em; cursor: pointer; transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease; }
  .landing-palette__tabs button svg { width: 14px; height: 14px; flex: none; }
  .landing-palette__tabs button:hover { color: var(--text); border-color: #3d3d3d; background: rgba(255, 255, 255, 0.04); }
  .landing-palette__tabs button[aria-pressed="true"] { color: var(--text); border-color: #525252; background: rgba(255, 255, 255, 0.08); }
  .landing-palette__tabs button:focus-visible { outline: 2px solid var(--accent-highlight); outline-offset: 2px; }
  @media (max-width: 860px) { .palette-demo { padding: 64px 0 80px; } }
  @media (forced-colors: active) { .palette-demo__highlight { background: none; color: CanvasText; } }
</style>
