---
import Layout from '../layouts/ConsoleLayout.astro';
import { Button, buttonVariants } from '../components/ui/button';
import { Input } from '../components/ui/input';
import { Card } from '../components/ui/card';
import { ConsoleSelect } from '../components/ConsoleSelect';
import { ConsoleNavigation } from '../components/ConsoleNavigation';
import { getCurrentUser, isAdmin } from '../lib/admin';
import AdminModelsFrame from '../components/dashboard/AdminModelsFrame.astro';
import { AdminModelsPanel } from '../components/dashboard/AdminModelsPanel';
import { AdminModelsSkeletonRows } from '../components/dashboard/AdminModelsSkeletonRows';
import DashboardTable from '../components/dashboard/DashboardTable.astro';
import DashboardSectionStatus from '../components/dashboard/DashboardSectionStatus.astro';

const user = await getCurrentUser(Astro.request);
if (!user) return Astro.redirect('/api/auth/signin?return_to=/admin');
if (!isAdmin(user)) return new Response('Forbidden', { status: 403 });


---
<Layout title="Nevermind · Admin" width="wide" cache={{ scope: user.id, storage: 'session' }}>
  <ConsoleNavigation email={user.email} admin={true} current="admin" />

  <div class="admin-console" id="admin-console" data-action-class={buttonVariants({ variant: "outline", size: "sm" })} data-email-class={buttonVariants({ variant: "ghost", size: "sm" })}>
    <header class="admin-header">
      <div>
        <h1>Am I making money?</h1>
        <p class="muted">Revenue from Stripe payments, cost from provider usage, Stripe fees estimated at 2.9% + 30¢. UTC calendar months.</p>
      </div>
      <label class="field">Month<Input id="month" type="month" /></label>
    </header>

    <div class="admin-alerts" aria-live="polite"><div id="problems"></div><span id="alerts-status"></span> <button type="button" id="alerts-retry" hidden>Retry alerts</button></div>

    <Card className="section admin-panel"><section>
      <DashboardSectionStatus section="overview" />
      <div class="stat-grid" id="headline" aria-label="Loading summary"><div class="stat"><span class="dashboard-skeleton"></span></div><div class="stat"><span class="dashboard-skeleton"></span></div><div class="stat"><span class="dashboard-skeleton"></span></div><div class="stat"><span class="dashboard-skeleton"></span></div></div>
      <DashboardTable class="admin-subpanel" id="segments" visibleRows={2} columns={['', 'Users', 'Active', 'Requests', 'Provider cost', 'Revenue', 'Net', 'Cost / active user']} />
    </section></Card>

    <Card className="section admin-panel"><section>
      <h2>Pricing</h2>
      <DashboardSectionStatus section="pricing" expandableTable="knobs" />
      <p class="muted">Set in Vercel env (<code>CREDIT_MARKUP</code>, <code>CREDIT_USD</code>, <code>MONTHLY_FREE_CREDITS</code>, <code>STRIPE_SUBSCRIPTION_TIERS</code>, <code>STRIPE_TOP_UP_PACKS</code>). Worst case means the user spends every credit they get.</p>
      <DashboardTable id="knobs" visibleRows={6} columns={['Plan', 'Price', 'Credits / month', 'Worst-case cost', 'Worst-case net']} />
      <p class="muted" id="knobs-note"></p>
    </section></Card>

    <Card className="section admin-panel"><section>
      <h2>Top users by cost</h2>
      <DashboardSectionStatus section="users" />
      <DashboardTable id="top-users" visibleRows={4} rowHeight="action" scrollable columns={['Email', 'Plan', 'Requests', 'Cost', 'Revenue', 'Net']} />
      <div class="admin-subpanel">
        <h3>Give or remove credits</h3>
        <div class="row admin-grant">
          <label class="field">Email<Input id="grant-email" type="email" autoComplete="off" /></label>
          <label class="field">Pool<ConsoleSelect id="grant-kind" options={[{ value: "paid", label: "Paid" }, { value: "free", label: "Free" }]} /></label>
          <label class="field">Credits<Input id="grant-delta" type="number" step="1" placeholder="250 or -50" /></label>
          <label class="field">Reason<Input id="grant-reason" type="text" maxLength={500} /></label>
          <Button variant="default" id="grant" type="button">Apply</Button>
          <span class="status" id="grant-status" aria-live="polite"></span>
        </div>
      </div>
    </section></Card>

    <Card className="section admin-panel"><section>
      <h2>Cost by model</h2>
      <DashboardSectionStatus section="models" expandableTable="models" />
      <DashboardTable id="models" visibleRows={8} columns={['Model', 'Provider', 'Who', 'Requests', 'Cost']} />
    </section></Card>

    <Card className="section admin-panel"><section>
      <h2>Model performance</h2>
      <DashboardSectionStatus section="performance" expandableTable="performance" />
      <p class="muted">Successful HTTP requests this month, measured at the backend rather than the desktop. TTFT starts at request admission and ends at the first parsed text, reasoning or tool output, ignoring keepalives. Turn time ends when the response finishes. Tokens/s is the mean per-request output rate after TTFT, estimated when provider token counts are missing; partial streams may contribute. Sample counts appear below each mean; historical requests have no TTFT.</p>
      <DashboardTable id="performance" visibleRows={6} rowHeight="double" columns={['Model', 'Provider', 'Requests', 'Mean TTFT', 'Mean turn time', 'Mean tokens/s (est.)']} />
    </section></Card>

    <AdminModelsFrame>
      <AdminModelsPanel client:only="react"><AdminModelsSkeletonRows slot="fallback" /></AdminModelsPanel>
    </AdminModelsFrame>

    <Card className="section admin-panel"><section>
      <h2>Free usage cap</h2>
      <p class="muted" id="cap-state">Loading…</p>
      <div class="row admin-grant">
        <label class="field">Monthly cap (USD)<Input id="cap-usd" type="text" inputMode="decimal" placeholder="25.00" /></label>
        <label class="field">Applies to<ConsoleSelect id="cap-effective" options={[{ value: "current", label: "This month" }, { value: "next_month", label: "Next month" }]} /></label>
        <Button variant="default" id="cap-set" type="button">Set</Button>
        <Button variant="outline" id="cap-clear" type="button">Remove cap</Button>
        <span class="status" id="cap-status" aria-live="polite"></span>
      </div>
    </section></Card>
  </div>

  <script>
    // @ts-nocheck
    import { keepPreviousData, QueriesObserver, QueryObserver } from '@tanstack/query-core';
    import { adminMutation } from '../lib/admin-mutation-request';
    import { dashboardCacheRestored } from '../lib/dashboard-query-client';
    import { createDashboardTableUpdates } from '../lib/dashboard-table-updates';
    import { TextMorph } from 'torph';
    const adminConsole = document.getElementById('admin-console');
    const actionButtonClass = adminConsole.dataset.actionClass;
    const emailButtonClass = adminConsole.dataset.emailClass;
    const usd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const integer = new Intl.NumberFormat('en-US');
    const monthInput = document.getElementById('month');

    function esc(value) {
      return String(value ?? '').replace(/[&<>"']/g, (char) => `&#${char.charCodeAt(0)};`);
    }
    function money(value) { return value == null ? '—' : usd.format(value); }
    function performanceMean(value, samples, unit) {
      return value == null ? '—' : `${(unit === 's' ? value / 1000 : value).toFixed(2)} ${unit}<br><small class="muted">${integer.format(samples)} samples</small>`;
    }
    function signedMoney(value) {
      return `<span class="${value < 0 ? 'status--err' : 'status--ok'}">${money(value)}</span>`;
    }
    function setStatus(element, message, kind = '') {
      element.textContent = message;
      element.className = `status${kind ? ` status--${kind}` : ''}`;
    }
    const tableUpdates = createDashboardTableUpdates();
    function fillRows(tableId, rows, columns, onApplied = () => {}) {
      const body = document.querySelector(`#${tableId} tbody`);
      const container = body.closest('.dashboard-table');
      const visibleRows = container.hasAttribute('data-scrollable') ? Infinity : Number(container.dataset.visibleRows);
      const html = rows.length
        ? rows.map((row, index) => `<tr${index >= visibleRows ? ' data-overflow' : ''}>${row.map((cell) => `<td>${cell}</td>`).join('')}</tr>`).join('')
        : `<tr><td colspan="${columns}" class="muted">Nothing this month.</td></tr>`;
      if (body.innerHTML === html) { tableUpdates.cancel(body); onApplied(); return true; }
      return tableUpdates.update(body, body.contains(document.activeElement), () => {
        body.innerHTML = html;
        syncTableToggle(tableId);
        onApplied();
      });
    }
    function syncTableToggle(tableId) {
      const toggle = document.querySelector(`[data-table-toggle="${tableId}"]`);
      if (!toggle) return;
      const container = document.getElementById(tableId).closest('.dashboard-table');
      const rowCount = container.querySelectorAll('tbody tr').length;
      const expanded = container.hasAttribute('data-expanded');
      toggle.hidden = rowCount <= Number(container.dataset.visibleRows);
      toggle.textContent = expanded ? 'Show fewer' : `Show all ${integer.format(rowCount)}`;
      toggle.setAttribute('aria-expanded', String(expanded));
    }
    document.querySelectorAll('[data-table-toggle]').forEach((toggle) => toggle.addEventListener('click', () => {
      const tableId = toggle.dataset.tableToggle;
      document.getElementById(tableId).closest('.dashboard-table').toggleAttribute('data-expanded');
      syncTableToggle(tableId);
    }));

    document.getElementById('admin-console').addEventListener('focusout', (event) => {
      const body = event.target.closest('tbody');
      if (!body) return;
      queueMicrotask(() => tableUpdates.flush(body, body.contains(document.activeElement)));
    });

    const headlineMorphs = new Map();
    function renderHeadline(total) {
      const headline = document.getElementById('headline');
      const values = [
        ['Revenue', total.revenueUsd], ['Provider cost', total.costUsd],
        ['Stripe fees (est.)', total.feesUsd], ['Net', total.netUsd],
      ];
      if (!headlineMorphs.size) {
        headline.removeAttribute('aria-label');
        headline.innerHTML = values.map(([label]) => `<div class="stat"><div class="v"></div><div class="l">${label}</div></div>`).join('');
        headline.querySelectorAll('.v').forEach((element, index) => {
          headlineMorphs.set(values[index][0], new TextMorph({ element, duration: 180, scale: false, respectReducedMotion: true }));
        });
      }
      values.forEach(([label, value]) => {
        const morph = headlineMorphs.get(label);
        const element = headline.querySelectorAll('.v')[values.findIndex(([name]) => name === label)];
        if (label === 'Net') element.className = `v ${value < 0 ? 'status--err' : 'status--ok'}`;
        morph.update(money(value));
      });
    }

    function renderSummary(summary, section, onApplied) {
      if (section === 'overview') {
      const { total, paying, free } = summary;
      renderHeadline(total);
      fillRows('segments', [['Paying', paying], ['Free', free]].map(([label, segment]) => [
        `<strong>${label}</strong>`,
        integer.format(segment.users),
        integer.format(segment.activeUsers),
        integer.format(segment.requests),
        money(segment.costUsd),
        money(segment.revenueUsd),
        signedMoney(segment.netUsd),
        segment.activeUsers ? money(segment.costUsd / segment.activeUsers) : '—',
      ]), 8);
      }
      if (section === 'pricing') renderKnobs(summary.knobs);
      if (section === 'performance') {
      fillRows('performance', summary.performance.map((row) => [
        `<code>${esc(row.model)}</code>`, esc(row.provider ?? '—'), integer.format(row.requests),
        performanceMean(row.meanTtftMs, row.ttftSamples, 's'),
        performanceMean(row.meanTurnMs, row.timedRequests, 's'),
        performanceMean(row.meanTokensPerSecond, row.throughputSamples, 'tok/s'),
      ]), 6);
      }
      if (section === 'users') {
      fillRows('top-users', summary.topUsers.map((row) => [
        `<button type="button" class="${emailButtonClass}" data-pick-email="${esc(row.email)}">${esc(row.email)}</button>`,
        row.paying ? 'Paying' : 'Free',
        integer.format(row.requests),
        money(row.costUsd),
        money(row.revenueUsd),
        signedMoney(row.netUsd),
      ]), 6, onApplied);
      return;
      }
      if (section === 'models') {
      fillRows('models', summary.models.map((row) => [
        `<code>${esc(row.model)}</code>`,
        esc(row.provider ?? '—'),
        row.paying ? 'Paying' : 'Free',
        integer.format(row.requests),
        money(row.costUsd),
      ]), 5);
      }
      onApplied();
    }

    function renderKnobs(knobs) {
      const note = document.getElementById('knobs-note');
      if (!knobs) {
        fillRows('knobs', [], 5);
        note.textContent = 'Billing config could not be read; check the Stripe env vars.';
        return;
      }
      fillRows('knobs', [
        ['Free', money(0), integer.format(knobs.monthlyFreeCredits), money(knobs.maxFreeUserCostUsd), signedMoney(-knobs.maxFreeUserCostUsd)],
        ...knobs.subscriptions.map((item) => [esc(item.tier), money(item.priceUsd), `${integer.format(item.credits)} + ${integer.format(knobs.monthlyFreeCredits)} free`, money(item.maxCostUsd), item.worstCaseNetUsd == null ? '—' : signedMoney(item.worstCaseNetUsd)]),
        ...knobs.topUps.map((item) => ['Top-up', money(item.priceUsd), integer.format(item.credits), money(item.maxCostUsd), '']),
      ], 5);
      note.textContent = `1 credit = ${money(knobs.creditUsd)} retail at ${knobs.markup}× markup over provider cost.`;
    }

    function renderProblems(breakers, cap) {
      const problems = [];
      if (cap.current?.halted) problems.push('<div class="admin-notice admin-notice--warning">Free usage cap reached — free users are blocked until next month or a higher cap.</div>');
      for (const breaker of breakers) {
        problems.push(`<div class="admin-notice admin-notice--warning">Route <code>${esc(breaker.routeSlot)}</code> (${esc(breaker.provider)}/${esc(breaker.modelId)}) is off: ${esc(breaker.reason)}. <button type="button" class="${actionButtonClass}" data-breaker='${esc(JSON.stringify({ routeSlot: breaker.routeSlot, provider: breaker.provider, modelId: breaker.modelId }))}'>Turn back on</button></div>`);
      }
      const container = document.getElementById('problems');
      const html = problems.join('');
      if (container.innerHTML === html || container.contains(document.activeElement)) return;
      container.innerHTML = html;
      container.querySelectorAll('[data-breaker]').forEach((button) => button.addEventListener('click', async () => {
        button.disabled = true;
        try { await adminMutation('/api/admin/route-breakers', 'POST', JSON.parse(button.dataset.breaker)); invalidateDashboard(); }
        catch (error) { button.disabled = false; button.textContent = error.message; }
      }));
    }

    function renderCap(cap) {
      const budget = cap.current;
      const spent = budget ? (Number(budget.actualFreeCostMicrocents) + Number(budget.reservedFreeCostMicrocents)) / 1e8 : 0;
      const capUsd = budget?.capMicrocents == null ? null : Number(budget.capMicrocents) / 1e8;
      const next = cap.nextMonth?.capMicrocents == null ? 'none' : money(Number(cap.nextMonth.capMicrocents) / 1e8);
      document.getElementById('cap-state').textContent = capUsd == null
        ? `No cap: free users can cost unlimited money. Spent on free users this month: ${money(spent)}. Next month's cap: ${next}.`
        : `Spent ${money(spent)} of ${money(capUsd)} this month${budget.halted ? ' — free usage is blocked' : ''}. Next month's cap: ${next}.`;
    }

    let client;
    function invalidateDashboard() { void client?.invalidateQueries(); }
    function invalidateSummary() {
      void client?.invalidateQueries({ predicate: (query) => String(query.queryKey[0]).startsWith('/api/admin/summary') });
    }

    const summarySections = ['overview', 'pricing', 'users', 'models', 'performance'];
    const sectionRefreshMs = { pricing: 300_000 };
    const displayedMonths = {};
    const sectionObservers = {};
    function summaryUrl(section, month) {
      return `/api/admin/summary?month=${encodeURIComponent(month)}&section=${section}`;
    }
    function sectionQueryOptions(section) {
      return {
        queryKey: [summaryUrl(section, monthInput.value)],
        placeholderData: keepPreviousData,
        ...(sectionRefreshMs[section] ? { refetchInterval: sectionRefreshMs[section] } : {}),
      };
    }
    function updatedAtLabel(timestamp) {
      return new Date(timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }
    function sectionStatusText(section, result) {
      const month = monthInput.value;
      const shown = displayedMonths[section];
      if (result.isError) return `${shown ? `Showing ${shown}. ` : ''}Could not load ${month}: ${result.error.message}`;
      if (!result.data) return `Loading ${month}…`;
      if (result.isPlaceholderData) return `Showing ${shown}; loading ${month}…`;
      return `Showing ${month} · updated ${updatedAtLabel(result.dataUpdatedAt)}`;
    }
    function renderSectionResult(section, result) {
      const status = document.getElementById(`${section}-status`);
      status.parentElement.toggleAttribute('data-fetching', result.isFetching && Boolean(result.data));
      document.querySelector(`[data-retry-section="${section}"]`).hidden = !result.isError;
      if (!result.data || result.isPlaceholderData) { status.textContent = sectionStatusText(section, result); return; }
      const month = monthInput.value;
      renderSummary(result.data, section, () => {
        displayedMonths[section] = month;
        status.textContent = sectionStatusText(section, result);
      });
    }
    function watchSection(section) {
      const observer = new QueryObserver(client, sectionQueryOptions(section));
      sectionObservers[section] = observer;
      observer.subscribe((result) => renderSectionResult(section, result));
      renderSectionResult(section, observer.getCurrentResult());
    }
    function showSelectedMonth() {
      history.replaceState(null, '', `?month=${encodeURIComponent(monthInput.value)}`);
      tableUpdates.cancel(document.querySelector('#top-users tbody'));
      for (const section of summarySections) sectionObservers[section]?.setOptions(sectionQueryOptions(section));
    }

    const alertUrls = ['/api/admin/route-breakers', '/api/admin/free-spend-cap'];
    function renderAlerts([breakersResult, capResult]) {
      const failed = [breakersResult, capResult].find((result) => result.isError);
      document.getElementById('alerts-status').textContent = failed ? `Could not refresh alerts: ${failed.error.message}` : '';
      document.getElementById('alerts-retry').hidden = !failed;
      if (capResult.data) renderCap(capResult.data);
      if (breakersResult.data && capResult.data) renderProblems(breakersResult.data.breakers, capResult.data);
    }
    function watchAlerts() {
      const observer = new QueriesObserver(client, alertUrls.map((url) => ({ queryKey: [url] })));
      observer.subscribe(renderAlerts);
      renderAlerts(observer.getCurrentResult());
    }
    function retryAlerts() {
      for (const url of alertUrls) void client?.refetchQueries({ queryKey: [url] });
    }
    document.getElementById('top-users').addEventListener('click', (event) => {
      const button = event.target.closest('[data-pick-email]');
      if (button) document.getElementById('grant-email').value = button.dataset.pickEmail;
    });
    document.querySelectorAll('[data-retry-section]').forEach((button) => button.addEventListener('click', () => sectionObservers[button.dataset.retrySection]?.refetch()));
    document.getElementById('alerts-retry').addEventListener('click', retryAlerts);

    document.getElementById('grant').addEventListener('click', async () => {
      const status = document.getElementById('grant-status');
      const payload = {
        email: document.getElementById('grant-email').value.trim().toLowerCase(),
        kind: document.getElementById('grant-kind').value,
        delta: Number(document.getElementById('grant-delta').value),
        reason: document.getElementById('grant-reason').value.trim(),
      };
      if (!payload.email || !Number.isInteger(payload.delta) || payload.delta === 0 || !payload.reason) {
        setStatus(status, 'Enter an email, a non-zero whole number, and a reason.', 'err');
        return;
      }
      setStatus(status, 'Applying…');
      try {
        const result = await adminMutation('/api/admin/credits', 'POST', payload);
        setStatus(status, `Done. ${result.kind} balance is now ${integer.format(result.balance)}.`, 'ok');
        invalidateSummary();
      } catch (error) { setStatus(status, error.message, 'err'); }
    });

    async function saveCap(clear) {
      const status = document.getElementById('cap-status');
      try {
        const value = document.getElementById('cap-usd').value.trim();
        if (!clear && !/^\d+(\.\d{1,2})?$/.test(value)) throw new Error('Enter a dollar amount like 25 or 25.50.');
        const capMicrocents = clear ? null : Math.round(Number(value) * 1e8);
        setStatus(status, 'Saving…');
        await adminMutation('/api/admin/free-spend-cap', 'POST', { capMicrocents, effective: document.getElementById('cap-effective').value });
        setStatus(status, 'Saved.', 'ok');
        invalidateDashboard();
      } catch (error) { setStatus(status, error.message, 'err'); }
    }
    document.getElementById('cap-set').addEventListener('click', () => saveCap(false));
    document.getElementById('cap-clear').addEventListener('click', () => saveCap(true));

    const now = new Date();
    monthInput.value = new URLSearchParams(location.search).get('month') || `${now.getUTCFullYear()}-${String(now.getUTCMonth() + 1).padStart(2, '0')}`;
    monthInput.addEventListener('change', showSelectedMonth);
    void dashboardCacheRestored().then((restoredClient) => {
      client = restoredClient;
      summarySections.forEach(watchSection);
      watchAlerts();
    });
  </script>
</Layout>
