---
import Layout from '../layouts/Layout.astro';
import Combobox from '../components/Combobox.astro';
import { getCurrentUser, isAdmin } from '../lib/admin';
import {
  DEFAULT_THINKING_LEVEL,
  getAudioModelRoute,
  getModelRoute,
  listKnownProviders,
  modelRouteToRef,
  ModelNotConfiguredError,
  THINKING_LEVELS,
  type ModelRouteConfig,
  type ModelRouteSlot,
} from '../lib/settings';
import { listReviewedImageModelsForProvider } from '../lib/pricing';
import { listTranscriptionModels } from '../lib/transcription-models';

const user = await getCurrentUser(Astro.request);
if (!user) return Astro.redirect('/api/auth/signin?return_to=/admin');
if (!isAdmin(user)) return new Response('Forbidden', { status: 403 });

async function safeModelRoute(
  slot: ModelRouteSlot,
): Promise<(ModelRouteConfig & { ref: string }) | null> {
  try {
    const route = await getModelRoute(slot);
    return { ...route, ref: modelRouteToRef(route) };
  } catch (err) {
    if (err instanceof ModelNotConfiguredError) return null;
    throw err;
  }
}
const modelRoutes = await Promise.all(
  (
    [
      ['pro-smart', 'Pro smart'],
      ['pro-fast', 'Pro fast'],
      ['free-smart', 'Free smart'],
      ['free-fast', 'Free fast'],
    ] as const
  ).map(async ([slot, title]) => ({ slot, title, route: await safeModelRoute(slot) })),
);
const modelOptions = (
  await Promise.all(
    listKnownProviders().map(async (provider) =>
      (await listReviewedImageModelsForProvider(provider)).map((modelId) =>
        modelRouteToRef({ provider, modelId }),
      ),
    ),
  )
).flat();
const audioRoute = await getAudioModelRoute().catch(() => null);
const audioRouteRef = audioRoute ? modelRouteToRef(audioRoute) : null;
const audioModelRefs = (await listTranscriptionModels().catch(() => [])).map(
  (model) => modelRouteToRef(model),
);
---
<Layout title="Nevermind · Admin" width="wide">
  <Combobox />
  <nav class="nav">
    <a href="/profile">Profile</a>
    <a href="/admin" aria-current="page">Admin</a>
    <span class="spacer"></span>
    <span class="muted"><code>{user.email}</code></span>
  </nav>

  <main class="admin-console">
    <header class="admin-header">
      <div>
        <h1>Am I making money?</h1>
        <p class="muted">Revenue from Stripe payments, cost from provider usage, Stripe fees estimated at 2.9% + 30¢. UTC calendar months.</p>
      </div>
      <label class="field">Month<input class="input" id="month" type="month" /></label>
    </header>

    <div class="admin-alerts" id="problems" aria-live="polite"></div>

    <section class="section card admin-panel">
      <div class="stat-grid" id="headline"><div class="stat"><div class="v">…</div><div class="l">Loading</div></div></div>
      <div class="table-scroll admin-subpanel">
        <table class="table" id="segments"><thead><tr><th></th><th>Users</th><th>Active</th><th>Requests</th><th>Provider cost</th><th>Revenue</th><th>Net</th><th>Cost / active user</th></tr></thead><tbody></tbody></table>
      </div>
    </section>

    <section class="section card admin-panel">
      <h2>Pricing</h2>
      <p class="muted">Set in Vercel env (<code>CREDIT_MARKUP</code>, <code>CREDIT_USD</code>, <code>MONTHLY_FREE_CREDITS</code>, <code>STRIPE_SUBSCRIPTION_TIERS</code>, <code>STRIPE_TOP_UP_PACKS</code>). Worst case means the user spends every credit they get.</p>
      <div class="table-scroll"><table class="table" id="knobs"><thead><tr><th>Plan</th><th>Price</th><th>Credits / month</th><th>Worst-case cost</th><th>Worst-case net</th></tr></thead><tbody></tbody></table></div>
      <p class="muted" id="knobs-note"></p>
    </section>

    <section class="section card admin-panel">
      <h2>Top users by cost</h2>
      <div class="table-scroll"><table class="table" id="top-users"><thead><tr><th>Email</th><th>Plan</th><th>Requests</th><th>Cost</th><th>Revenue</th><th>Net</th></tr></thead><tbody></tbody></table></div>
      <div class="admin-subpanel">
        <h3>Give or remove credits</h3>
        <div class="row admin-grant">
          <label class="field">Email<input class="input" id="grant-email" type="email" autocomplete="off" /></label>
          <label class="field">Pool<select class="input" id="grant-kind"><option value="paid">Paid</option><option value="free">Free</option></select></label>
          <label class="field">Credits<input class="input" id="grant-delta" type="number" step="1" placeholder="250 or -50" /></label>
          <label class="field">Reason<input class="input" id="grant-reason" type="text" maxlength="500" /></label>
          <button class="button button--primary" id="grant" type="button">Apply</button>
          <span class="status" id="grant-status" aria-live="polite"></span>
        </div>
      </div>
    </section>

    <section class="section card admin-panel">
      <h2>Cost by model</h2>
      <div class="table-scroll"><table class="table" id="models"><thead><tr><th>Model</th><th>Provider</th><th>Who</th><th>Requests</th><th>Cost</th></tr></thead><tbody></tbody></table></div>
    </section>

    <section class="section card admin-panel">
      <h2>Models</h2>
      <div class="model-routes">
        {modelRoutes.map(({ slot, title, route }) => (
          <section class="model-route-row" data-model-route={slot}>
            <header class="model-route-row__header"><strong>{title}</strong><span class="status" data-status></span></header>
            <label class="field">Model<select class="input combo model-select">{route && !modelOptions.includes(route.ref) && <option value={route.ref} selected disabled>{route.ref} (not selectable)</option>}{modelOptions.map((ref) => <option value={ref} selected={ref === route?.ref}>{ref}</option>)}</select></label>
            <label class="field model-route-row__thinking">Thinking<select class="input thinking-select">{THINKING_LEVELS.map((level) => <option value={level} selected={level === (route?.thinkingLevel ?? DEFAULT_THINKING_LEVEL)}>{level}</option>)}</select></label>
            <div class="route-details muted" data-pricing></div>
          </section>
        ))}
        <section class="model-route-row" data-audio-model-route>
          <header class="model-route-row__header"><strong>Dictation</strong><span class="status" data-status></span></header>
          <label class="field">Model<select class="input combo model-select">{audioModelRefs.map((ref) => <option value={ref} selected={ref === audioRouteRef}>{ref}</option>)}</select></label>
        </section>
      </div>
    </section>

    <section class="section card admin-panel">
      <h2>Free usage cap</h2>
      <p class="muted" id="cap-state">Loading…</p>
      <div class="row admin-grant">
        <label class="field">Monthly cap (USD)<input class="input" id="cap-usd" type="text" inputmode="decimal" placeholder="25.00" /></label>
        <label class="field">Applies to<select class="input" id="cap-effective"><option value="current">This month</option><option value="next_month">Next month</option></select></label>
        <button class="button button--primary" id="cap-set" type="button">Set</button>
        <button class="button" id="cap-clear" type="button">Remove cap</button>
        <span class="status" id="cap-status" aria-live="polite"></span>
      </div>
    </section>
  </main>

  <script is:inline>
    const usd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const integer = new Intl.NumberFormat('en-US');
    const monthInput = document.getElementById('month');

    function esc(value) {
      return String(value ?? '').replace(/[&<>"']/g, (char) => `&#${char.charCodeAt(0)};`);
    }
    function money(value) { return value == null ? '—' : usd.format(value); }
    function signedMoney(value) {
      return `<span class="${value < 0 ? 'status--err' : 'status--ok'}">${money(value)}</span>`;
    }
    function setStatus(element, message, kind = '') {
      element.textContent = message;
      element.className = `status${kind ? ` status--${kind}` : ''}`;
    }
    async function errorMessage(response) {
      try { return (await response.json()).error?.message || response.statusText; } catch { return response.statusText; }
    }
    async function getJson(path) {
      const response = await fetch(path);
      if (!response.ok) throw new Error(await errorMessage(response));
      return response.json();
    }
    async function adminMutation(path, method, payload) {
      const response = await fetch(path, {
        method,
        headers: { 'Content-Type': 'application/json', 'Idempotency-Key': crypto.randomUUID() },
        body: JSON.stringify(payload),
      });
      if (!response.ok) throw new Error(await errorMessage(response));
      return response.json();
    }
    function fillRows(tableId, rows, columns) {
      document.querySelector(`#${tableId} tbody`).innerHTML = rows.length
        ? rows.map((row) => `<tr>${row.map((cell) => `<td>${cell}</td>`).join('')}</tr>`).join('')
        : `<tr><td colspan="${columns}" class="muted">Nothing this month.</td></tr>`;
    }

    function renderSummary(summary) {
      const { total, paying, free } = summary;
      document.getElementById('headline').innerHTML = [
        ['Revenue', money(total.revenueUsd)],
        ['Provider cost', money(total.costUsd)],
        ['Stripe fees (est.)', money(total.feesUsd)],
        ['Net', signedMoney(total.netUsd)],
      ].map(([label, value]) => `<div class="stat"><div class="v">${value}</div><div class="l">${label}</div></div>`).join('');
      fillRows('segments', [['Paying', paying], ['Free', free]].map(([label, segment]) => [
        `<strong>${label}</strong>`,
        integer.format(segment.users),
        integer.format(segment.activeUsers),
        integer.format(segment.requests),
        money(segment.costUsd),
        money(segment.revenueUsd),
        signedMoney(segment.netUsd),
        segment.activeUsers ? money(segment.costUsd / segment.activeUsers) : '—',
      ]), 8);
      renderKnobs(summary.knobs);
      fillRows('top-users', summary.topUsers.map((row) => [
        `<button type="button" class="button button--ghost" data-pick-email="${esc(row.email)}">${esc(row.email)}</button>`,
        row.paying ? 'Paying' : 'Free',
        integer.format(row.requests),
        money(row.costUsd),
        money(row.revenueUsd),
        signedMoney(row.netUsd),
      ]), 6);
      document.querySelectorAll('[data-pick-email]').forEach((button) => button.addEventListener('click', () => {
        document.getElementById('grant-email').value = button.dataset.pickEmail;
      }));
      fillRows('models', summary.models.map((row) => [
        `<code>${esc(row.model)}</code>`,
        esc(row.provider ?? '—'),
        row.paying ? 'Paying' : 'Free',
        integer.format(row.requests),
        money(row.costUsd),
      ]), 5);
      return summary.problems.stuckPayments;
    }

    function renderKnobs(knobs) {
      const note = document.getElementById('knobs-note');
      if (!knobs) {
        fillRows('knobs', [], 5);
        note.textContent = 'Billing config could not be read; check the Stripe env vars.';
        return;
      }
      fillRows('knobs', [
        ['Free', money(0), integer.format(knobs.monthlyFreeCredits), money(knobs.maxFreeUserCostUsd), signedMoney(-knobs.maxFreeUserCostUsd)],
        ...knobs.subscriptions.map((item) => [esc(item.tier), money(item.priceUsd), `${integer.format(item.credits)} + ${integer.format(knobs.monthlyFreeCredits)} free`, money(item.maxCostUsd), item.worstCaseNetUsd == null ? '—' : signedMoney(item.worstCaseNetUsd)]),
        ...knobs.topUps.map((item) => ['Top-up', money(item.priceUsd), integer.format(item.credits), money(item.maxCostUsd), '']),
      ], 5);
      note.textContent = `1 credit = ${money(knobs.creditUsd)} retail at ${knobs.markup}× markup over provider cost.`;
    }

    async function loadProblems(stuckPayments) {
      const problems = [];
      if (stuckPayments > 0) problems.push(`<div class="admin-notice admin-notice--warning">${stuckPayments} payment(s) need manual review — check Stripe and the webhook logs.</div>`);
      const [{ breakers }, cap] = await Promise.all([getJson('/api/admin/route-breakers'), getJson('/api/admin/free-spend-cap')]);
      if (cap.current?.halted) problems.push('<div class="admin-notice admin-notice--warning">Free usage cap reached — free users are blocked until next month or a higher cap.</div>');
      for (const breaker of breakers) {
        problems.push(`<div class="admin-notice admin-notice--warning">Route <code>${esc(breaker.routeSlot)}</code> (${esc(breaker.provider)}/${esc(breaker.modelId)}) is off: ${esc(breaker.reason)}. <button type="button" class="button" data-breaker='${esc(JSON.stringify({ routeSlot: breaker.routeSlot, provider: breaker.provider, modelId: breaker.modelId }))}'>Turn back on</button></div>`);
      }
      const container = document.getElementById('problems');
      container.innerHTML = problems.join('');
      container.querySelectorAll('[data-breaker]').forEach((button) => button.addEventListener('click', async () => {
        button.disabled = true;
        try { await adminMutation('/api/admin/route-breakers', 'POST', JSON.parse(button.dataset.breaker)); await refresh(); }
        catch (error) { button.disabled = false; button.textContent = error.message; }
      }));
      renderCap(cap);
    }

    function renderCap(cap) {
      const budget = cap.current;
      const spent = budget ? (Number(budget.actualFreeCostMicrocents) + Number(budget.reservedFreeCostMicrocents)) / 1e8 : 0;
      const capUsd = budget?.capMicrocents == null ? null : Number(budget.capMicrocents) / 1e8;
      const next = cap.nextMonth?.capMicrocents == null ? 'none' : money(Number(cap.nextMonth.capMicrocents) / 1e8);
      document.getElementById('cap-state').textContent = capUsd == null
        ? `No cap: free users can cost unlimited money. Spent on free users this month: ${money(spent)}. Next month's cap: ${next}.`
        : `Spent ${money(spent)} of ${money(capUsd)} this month${budget.halted ? ' — free usage is blocked' : ''}. Next month's cap: ${next}.`;
    }

    async function refresh() {
      const month = monthInput.value;
      history.replaceState(null, '', `?month=${month}`);
      try {
        const stuckPayments = renderSummary(await getJson(`/api/admin/summary?month=${encodeURIComponent(month)}`));
        await loadProblems(stuckPayments);
      } catch (error) {
        document.getElementById('problems').innerHTML = `<div class="admin-notice admin-notice--warning">Could not load: ${esc(error.message)}</div>`;
      }
    }

    document.getElementById('grant').addEventListener('click', async () => {
      const status = document.getElementById('grant-status');
      const payload = {
        email: document.getElementById('grant-email').value.trim().toLowerCase(),
        kind: document.getElementById('grant-kind').value,
        delta: Number(document.getElementById('grant-delta').value),
        reason: document.getElementById('grant-reason').value.trim(),
      };
      if (!payload.email || !Number.isInteger(payload.delta) || payload.delta === 0 || !payload.reason) {
        setStatus(status, 'Enter an email, a non-zero whole number, and a reason.', 'err');
        return;
      }
      setStatus(status, 'Applying…');
      try {
        const result = await adminMutation('/api/admin/credits', 'POST', payload);
        setStatus(status, `Done. ${result.kind} balance is now ${integer.format(result.balance)}.`, 'ok');
      } catch (error) { setStatus(status, error.message, 'err'); }
    });

    async function saveCap(clear) {
      const status = document.getElementById('cap-status');
      try {
        const value = document.getElementById('cap-usd').value.trim();
        if (!clear && !/^\d+(\.\d{1,2})?$/.test(value)) throw new Error('Enter a dollar amount like 25 or 25.50.');
        const capMicrocents = clear ? null : Math.round(Number(value) * 1e8);
        setStatus(status, 'Saving…');
        await adminMutation('/api/admin/free-spend-cap', 'POST', { capMicrocents, effective: document.getElementById('cap-effective').value });
        setStatus(status, 'Saved.', 'ok');
        await refresh();
      } catch (error) { setStatus(status, error.message, 'err'); }
    }
    document.getElementById('cap-set').addEventListener('click', () => saveCap(false));
    document.getElementById('cap-clear').addEventListener('click', () => saveCap(true));

    function splitRef(ref) {
      const separator = ref.indexOf('/');
      return { provider: ref.slice(0, separator), modelId: ref.slice(separator + 1) };
    }
    function perMillion(value) { return value == null ? '—' : `${usd.format(value)}/M`; }
    async function loadRoutePricing(row) {
      const target = row.querySelector('[data-pricing]');
      try {
        const query = new URLSearchParams({ slot: row.dataset.modelRoute, modelId: splitRef(row.querySelector('.model-select').value).modelId });
        const { primaryPricing } = await getJson(`/api/admin/model-providers?${query}`);
        target.textContent = primaryPricing ? `Input ${perMillion(primaryPricing.inputUsdPerMtok)} · Output ${perMillion(primaryPricing.outputUsdPerMtok)}` : 'Pricing unknown';
      } catch { target.textContent = 'Pricing unknown'; }
    }
    async function saveRoute(row, path, payload) {
      const status = row.querySelector('[data-status]');
      setStatus(status, 'Saving…');
      try { await adminMutation(path, 'PUT', payload); setStatus(status, 'Saved', 'ok'); }
      catch (error) { setStatus(status, error.message, 'err'); }
    }
    document.querySelectorAll('[data-model-route]').forEach((row) => {
      loadRoutePricing(row);
      row.querySelectorAll('select').forEach((select) => select.addEventListener('change', async () => {
        await saveRoute(row, '/api/admin/model', { purpose: row.dataset.modelRoute, modelRef: row.querySelector('.model-select').value, thinkingLevel: row.querySelector('.thinking-select').value });
        loadRoutePricing(row);
      }));
    });
    document.querySelectorAll('[data-audio-model-route]').forEach((row) => {
      row.querySelector('select').addEventListener('change', (event) => saveRoute(row, '/api/admin/audio-model', splitRef(event.currentTarget.value)));
    });

    const now = new Date();
    monthInput.value = new URLSearchParams(location.search).get('month') || `${now.getUTCFullYear()}-${String(now.getUTCMonth() + 1).padStart(2, '0')}`;
    monthInput.addEventListener('change', refresh);
    refresh();
  </script>
</Layout>
