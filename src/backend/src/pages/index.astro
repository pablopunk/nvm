---
import { Download } from '@lucide/astro';
import BuildOnce from '../components/BuildOnce.astro';
import LandingPaletteSection from '../components/LandingPaletteSection.astro';
import BringYourOwnAi from '../components/BringYourOwnAi.astro';
import DotfilesSetup from '../components/DotfilesSetup.astro';
import GitHubIcon from '../components/GitHubIcon.astro';
import LandingAccount from '../components/LandingAccount.astro';
import LightningAccent from '../components/LightningAccent.astro';
import Layout from '../layouts/Layout.astro';
---
<Layout title="Nevermind" width="wide" showHeader={false}>
  <div class="landing-shell">
    <LightningAccent />
    <header class="landing-nav" aria-label="Primary navigation">
      <a class="landing-brand" href="/" aria-label="Nevermind home">
        <img src="/icon.png" alt="" class="landing-brand__icon" />
        <span>Nevermind</span>
      </a>
      <nav class="landing-nav__links" aria-label="Product links">
        <a href="/pricing">Pricing</a>
      </nav>
      <div class="landing-nav__account">
        <LandingAccount placement="nav" server:defer>
          <a class="button" href="/api/auth/signin" slot="fallback">Sign in</a>
        </LandingAccount>
      </div>
    </header>

    <section class="landing-hero">
      <div class="landing-demo">
        <video
          id="product-demo"
          class="landing-demo__video"
          width="1280"
          height="720"
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          poster="/videos/nevermind-demo-v1.jpg"
          aria-label="Nevermind demo: create a Mac theme switcher, browse pull requests and calendar events, and process selected videos"
        >
          <source src="/videos/nevermind-demo-v2.mp4" type="video/mp4" />
          <a href="/videos/nevermind-demo-v2.mp4">Watch the Nevermind demo</a>
        </video>
      </div>
      <div class="landing-hero__copy">
        <div class="landing-platforms" aria-label="Supported platforms">
          <span class="landing-platforms__pill"><img src="/platforms/apple.svg" alt="" /> macOS</span>
          <span class="landing-platforms__pill"><img src="/platforms/windows.svg" alt="" /> Windows</span>
          <span class="landing-platforms__pill"><img src="/platforms/linux.svg" alt="" /> Linux</span>
        </div>
        <h1 class="landing-hero__title">
          <img src="/wordmark.png" alt="Nevermind" class="landing-wordmark" />
        </h1>
        <p class="landing-hero__lede">
          A command palette that extends itself. Really.
        </p>
        <div class="landing-actions">
          <a class="button button--primary button--lg landing-download" href="https://github.com/pablopunk/nvm/releases">
            <Download size={16} />Download for free
            <span class="landing-download__badge">alpha</span>
          </a>
          <a class="button button--ghost" href="https://github.com/pablopunk/nvm"><GitHubIcon />GitHub</a>
        </div>
      </div>
    </section>
    <BuildOnce />
    <LandingPaletteSection />
    <DotfilesSetup />
    <BringYourOwnAi />
  </div>
</Layout>
