---
import Layout from '../layouts/Layout.astro';
import { purchasableBillingCatalog, type BillingCatalogItem } from '../lib/billing';
import { getSessionFromCookies } from '../lib/workos';
import { publicBillingPrices } from '../lib/public-billing-prices';

function displayPriceFor(item: BillingCatalogItem): string | null {
  return priceDisplays.get(item.priceId)?.amount ?? null;
}

function listPriceFor(item: BillingCatalogItem): string | null {
  return priceDisplays.get(item.priceId)?.listAmount ?? null;
}

const catalog = (() => {
  try { return purchasableBillingCatalog(); } catch { return { subscriptions: [], topUps: [] }; }
})();
const hasSubscriptions = catalog.subscriptions.length > 0;
const priceDisplays = await publicBillingPrices([...catalog.subscriptions, ...catalog.topUps]);
const hasTopUps = catalog.topUps.length > 0;
const session = await getSessionFromCookies(Astro.request.headers.get('cookie'));
const isLoggedIn = Boolean(session);
---
<Layout title="Pricing · Nevermind">
  <section class="page-hero">
    <h1>Pricing</h1>
    <p>Every account includes free monthly credits. Upgrade when you need more — no hidden fees, cancel anytime.</p>
  </section>

  <div class="pricing-grid">
    <div class="price-card price-card--recommended">
      <span class="price-card__badge">Recommended</span>
      <h3>Free</h3>
      <div><span class="price-card__credits">$0</span><span class="price-card__period">/ month</span></div>
      <ul class="price-card__features">
        <li>Batteries included</li>
        <li><strong>No credit card</strong> required</li>
        <li>No need to <strong>sign in</strong></li>
        <li><strong>Unlimited transcriptions</strong></li>
        <li><strong>Free</strong> monthly credits to build with AI</li>
        <li><strong>Free</strong> monthly credits to chat with AI</li>
        <li>Bring <strong>your own AI</strong></li>
        <li><strong>Dotfiles</strong> friendly</li>
      </ul>
      <a class="button" href="https://github.com/pablopunk/nvm/releases">Download the app</a>
    </div>

    {catalog.subscriptions.map((tier) => {
      const displayPrice = displayPriceFor(tier);
      const listPrice = listPriceFor(tier);
      return (
        <div class="price-card">
          <span class="price-card__badge">Beta price</span>
          <h3>{tier.tier.charAt(0).toUpperCase() + tier.tier.slice(1)}</h3>
          {displayPrice ? (
            <div>{listPrice && <s class="price-card__period" aria-label={`Regular price ${listPrice}`}>{listPrice}</s>} <span class="price-card__credits">{displayPrice}</span><span class="price-card__period">/ {priceDisplays.get(tier.priceId)?.period}</span></div>
          ) : (
            <div class="price-card__desc">Price temporarily unavailable</div>
          )}
          <ul class="price-card__features">
            <li>Everything in Free</li>
            <li><strong>{tier.credits.toLocaleString('en')} AI credits</strong> each billing cycle</li>
            <li>The <strong>same model</strong> as Free, with far more usage</li>
            <li><strong>Build more tools</strong> with AI</li>
            <li><strong>Chat more</strong> with AI</li>
            {hasTopUps && <li><strong>Top up</strong> your credits whenever you need more</li>}
            <li><strong>Cancel</strong> anytime</li>
          </ul>
          {!isLoggedIn && (
            <a class="button button--primary" href={`/api/auth/signin?return_to=/profile`}>Get Started</a>
          )}
          {isLoggedIn && (
            <a class="button button--primary" href="/profile">Manage subscription</a>
          )}
        </div>
      );
    })}

    {!hasSubscriptions && (
      <div class="price-card">
        <h3>Pro</h3>
        <div><span class="price-card__credits">—</span></div>
        <p class="price-card__desc">Paid plans are not configured yet. Check back soon or <a href="https://github.com/pablopunk/nvm">star the repo</a> for updates.</p>
      </div>
    )}
  </div>

  {hasTopUps && (
    <div class="section">
      <h2>Top-ups</h2>
      <p class="muted">One-time credit packs for when you need more. Available with an active subscription.</p>
      <div class="top-up-section">
        {catalog.topUps.map((pack) => {
          const displayPrice = displayPriceFor(pack);
          return (
            <div class="top-up-card">
              <div class="top-up-card__credits">{pack.credits}</div>
              <div style="font-size:13px;color:var(--muted)">credits{displayPrice ? ` · ${displayPrice}` : ''}</div>
            </div>
          );
        })}
      </div>
    </div>
  )}

  <div class="section">
    <h2>How billing works</h2>
    <div class="billing-flow">
      <div class="billing-flow__step">
        <div class="step-number">1</div>
        <div>Monthly credits included</div>
      </div>
      <div class="billing-flow__step">
        <div class="step-number">2</div>
        <div>Usage charged in credits</div>
      </div>
      <div class="billing-flow__step">
        <div class="step-number">3</div>
        <div>Top up when you need more</div>
      </div>
      <div class="billing-flow__step">
        <div class="step-number">4</div>
        <div>Manage in Stripe portal</div>
      </div>
    </div>
    <p class="muted" style="margin-top:16px;text-align:center;font-size:13px">
      Free credits are consumed first, then paid credits. Manage or cancel your subscription from the <a href="/profile">profile page</a>.
    </p>
  </div>

  <div class="section">
    <h2>FAQ</h2>
    <div class="faq-item">
      <h3>What is a credit?</h3>
      <p>Credits are Nevermind's usage unit. A short chat or a small extension call costs about one credit, and larger requests with long context or lots of reasoning cost a few more. Free credits are included monthly; paid credits are purchased through a subscription or top-up.</p>
    </div>
    <div class="faq-item">
      <h3>Can I cancel anytime?</h3>
      <p>Yes. Cancel your subscription from the billing portal and you keep access until the current period ends. No long-term commitment.</p>
    </div>
    <div class="faq-item">
      <h3>Do unused credits roll over?</h3>
      <p>Monthly subscription credits reset each billing cycle. Top-up credits are available until consumed or your subscription ends.</p>
    </div>
    <div class="faq-item">
      <h3>What models are available?</h3>
      <p>Free and Pro use the same fast, capable model, so Pro simply gives you much more usage. Want a different model? Bring your own AI on any plan.</p>
    </div>
  </div>
</Layout>
