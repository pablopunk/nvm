---
import Layout from '../layouts/ConsoleLayout.astro';
import { Button, buttonVariants } from '../components/ui/button';
import ProfileBalances from '../components/dashboard/ProfileBalances.astro';
import ProfileTokens from '../components/dashboard/ProfileTokens.astro';
import ProfileBilling from '../components/dashboard/ProfileBilling.astro';
import { Input } from '../components/ui/input';
import { Card } from '../components/ui/card';
import { ConsoleNavigation } from '../components/ConsoleNavigation';
import { eq } from 'drizzle-orm';
import { getSessionFromCookies } from '../lib/workos';
import { db } from '../db/client';
import { users } from '../db/schema';

const session = await getSessionFromCookies(Astro.request.headers.get('cookie'));
if (!session) return Astro.redirect('/api/auth/signin?return_to=/profile');

const [user] = await db.select().from(users).where(eq(users.workosUserId, session.user.id)).limit(1);
const isAdmin = user?.role === 'admin';
const billingState = Astro.url.searchParams.get('billing');
---
<Layout title="Nevermind · Profile">
  <ConsoleNavigation email={user?.email ?? ""} admin={isAdmin} current="profile" />
  <header class="profile-header">
    <div>
      <h1>Profile</h1>
      <p class="muted"><code>{user?.email}</code> · {user?.plan} plan</p>
    </div>
  </header>

  <ProfileBalances server:defer>
    <div slot="fallback" class="section profile-balance-container" aria-busy="true" aria-label="Loading credits"><div class="stat-grid profile-stats"><div class="stat"><span class="dashboard-skeleton"></span></div><div class="stat"><span class="dashboard-skeleton"></span></div><div class="stat"><span class="dashboard-skeleton"></span></div></div></div>
  </ProfileBalances>

  <Card className="section profile-panel" id="connect-desktop">
    <h3>Connect desktop app</h3>
    <p class="muted">Sign into the Nevermind desktop app from this browser.</p>
    <Button variant="default" id="initiate-connect" type="button">Start device connection</Button>
    <p id="connect-status" class="status"></p>
    <pre id="connect-code" style="display:none;"></pre>
    <a id="connect-deep-link" class={buttonVariants({ variant: "outline" })} style="display:none;" href="#">Open in Nevermind</a>
    <script is:inline>
      var connectPending = false;
      var deepLinkUrl = '';
      var code = '';
      document.getElementById('initiate-connect').addEventListener('click', async function () {
        if (connectPending) return;
        connectPending = true;
        var status = document.getElementById('connect-status');
        var codeEl = document.getElementById('connect-code');
        var linkEl = document.getElementById('connect-deep-link');
        status.className = 'status';
        status.textContent = 'Initiating…';
        try {
          var res = await fetch('/api/auth/device/initiate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ label: navigator.platform }),
          });
          if (!res.ok) {
            status.className = 'status status--err';
            status.textContent = 'Could not connect. Try again.';
            connectPending = false;
            return;
          }
          var data = await res.json();
          code = data.code;
          var params = new URLSearchParams();
          params.set('code', code);
          params.set('base_url', window.location.origin);
          deepLinkUrl = 'nvm://auth?' + params.toString();
          codeEl.style.display = 'block';
          codeEl.textContent = 'Device code: ' + code + '\nOpen Nevermind or paste this code manually via Cmd+K → "Log in"';
          linkEl.href = deepLinkUrl;
          linkEl.style.display = '';
          status.className = 'status status--ok';
          status.textContent = 'Approval code ready. Click "Open in Nevermind" or enter the code manually.';
          status.style.display = '';
        } catch {
          status.className = 'status status--err';
          status.textContent = 'Could not connect. Try again.';
        } finally {
          connectPending = false;
        }
      });
    </script>
  </Card>

  <ProfileBilling server:defer billingState={billingState}>
    <Card slot="fallback" className="section profile-panel profile-billing" aria-busy="true" aria-label="Loading billing"><span class="dashboard-skeleton"></span><span class="dashboard-skeleton"></span><span class="dashboard-skeleton"></span></Card>
  </ProfileBilling>

  <Card className="section profile-panel">
    <h2 id="tokens-heading" tabindex="-1">API tokens</h2>
    <p class="muted">Use these to call the API directly. The full token is shown only once.</p>
    <form id="create-token-form" class="row items-end">
      <label class="field flex-1">Token name<Input type="text" name="name" placeholder="e.g. My Mac" required id="token-name" /></label>
      <Button variant="default" type="submit">Create token</Button>
    </form>
    <Card id="new-token-panel" className="profile-panel" style={{ display: "none" }} role="region" aria-label="New API token">
      <div>
        <h3>Your new API token</h3>
        <p class="muted">Save this token now — it will not be shown again.</p>
      </div>
      <pre class="token-value" id="new-token-value"></pre>
      <div id="copy-status" aria-live="polite" class="status"></div>
      <div class="row">
        <Button type="button" id="copy-token-btn" variant="default">Copy</Button>
        <Button type="button" id="close-token-btn" variant="outline">Close</Button>
      </div>
    </Card>
    <p id="token-status" class="status" aria-live="polite"></p>
    <ProfileTokens server:defer>
      <div slot="fallback" class="profile-token-list" aria-busy="true" aria-label="Loading API tokens"><span class="dashboard-skeleton"></span><span class="dashboard-skeleton"></span><span class="dashboard-skeleton"></span></div>
    </ProfileTokens>
  </Card>

  <script is:inline>
    const createTokenForm = document.getElementById('create-token-form');
    const createTokenBtn = createTokenForm.querySelector('button[type="submit"]');
    const createTokenInput = createTokenForm.querySelector('input[name="name"]');
    const newTokenPanel = document.getElementById('new-token-panel');
    const newTokenValue = document.getElementById('new-token-value');
    const copyTokenBtn = document.getElementById('copy-token-btn');
    const closeTokenBtn = document.getElementById('close-token-btn');
    const copyStatus = document.getElementById('copy-status');

    function setPanelVisible(visible) {
      newTokenPanel.style.display = visible ? '' : 'none';
      createTokenInput.disabled = visible;
      createTokenBtn.disabled = visible;
    }

    let undisclosedToken = null;

    function beforeUnloadHandler(e) {
      e.preventDefault();
      e.returnValue = '';
    }

    function dismissTokenPanel() {
      window.removeEventListener('beforeunload', beforeUnloadHandler);
      undisclosedToken = null;
      newTokenValue.textContent = '';
      setPanelVisible(false);
      location.reload();
    }

    function copyTokenToClipboard() {
      if (!undisclosedToken) return;
      copyStatus.textContent = '';
      copyStatus.className = 'status';
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(undisclosedToken).then(() => {
          copyStatus.textContent = 'Copied to clipboard.';
          copyStatus.className = 'status status--ok';
        }).catch(() => {
          fallbackCopyToken();
        });
      } else {
        fallbackCopyToken();
      }
    }

    function fallbackCopyToken() {
      const ta = document.createElement('textarea');
      ta.value = undisclosedToken;
      ta.style.position = 'fixed';
      ta.style.left = '-9999px';
      document.body.appendChild(ta);
      ta.select();
      try {
        const copied = document.execCommand('copy');
        if (copied) {
          copyStatus.textContent = 'Copied to clipboard.';
          copyStatus.className = 'status status--ok';
        } else {
          copyStatus.textContent = 'Could not copy automatically. Please select and copy the token manually.';
          copyStatus.className = 'status status--err';
        }
      } catch {
        copyStatus.textContent = 'Could not copy automatically. Please select and copy the token manually.';
        copyStatus.className = 'status status--err';
      } finally {
        document.body.removeChild(ta);
      }
    }

    createTokenForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (undisclosedToken || createTokenBtn.disabled) return;
      const status = document.getElementById('token-status');
      const fd = new FormData(e.target);
      createTokenBtn.disabled = true;
      status.className = 'status';
      status.textContent = 'Creating token…';
      try {
        const res = await fetch('/api/tokens', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: fd.get('name') }),
        });
        if (!res.ok) throw new Error('Could not create token; try again.');
        const data = await res.json();
        undisclosedToken = data.token;
        newTokenValue.textContent = data.token;
        setPanelVisible(true);
        status.textContent = '';
        copyStatus.textContent = '';
        copyStatus.className = 'status';
        window.addEventListener('beforeunload', beforeUnloadHandler);
        copyTokenBtn.focus();
      } catch {
        status.textContent = 'Could not create token; try again.';
        status.className = 'status status--err';
        createTokenBtn.disabled = false;
      }
    });

    copyTokenBtn.addEventListener('click', copyTokenToClipboard);
    closeTokenBtn.addEventListener('click', dismissTokenPanel);
    function showBillingError(message) {
      const billingStatus = document.getElementById('billing-status');
      billingStatus.textContent = message;
      billingStatus.className = 'status status--err';
    }
    async function openBillingUrl(path, body) {
      try {
        const response = await fetch(path, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: body ? JSON.stringify(body) : undefined,
        });
        const data = await response.json().catch(() => ({}));
        if (response.ok && data.url) location.href = data.url;
        else showBillingError(data.error?.message || 'Unable to open billing right now.');
      } catch {
        showBillingError('Unable to open billing right now.');
      }
    }
    document.addEventListener('click', (event) => {
      const button = event.target.closest('.billing-checkout, #manage-billing');
      if (!button) return;
      const status = document.getElementById('billing-status');
      button.disabled = true;
      status.className = 'status';
      status.textContent = 'Opening Stripe…';
      const checkout = button.classList.contains('billing-checkout');
      openBillingUrl(checkout ? '/api/billing/checkout' : '/api/billing/portal', checkout ? { kind: button.dataset.kind, priceId: button.dataset.priceId } : undefined)
        .finally(() => { button.disabled = false; });
    });

  </script>
</Layout>
