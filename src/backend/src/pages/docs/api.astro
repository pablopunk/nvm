---
import Layout from '../../layouts/Layout.astro';
import DocsNav from '../../components/DocsNav.astro';
import { docsData, type ApiEntry } from '../../lib/docs-data';
import { renderDocMarkup, summarizeDoc } from '../../lib/docs-markup';

export const prerender = true;

const featuredNames = ['NevermindExtension', 'ExtensionCommand', 'ExtensionContext'];
const featured = featuredNames.flatMap((name) => docsData.api.find((entry) => entry.name === name) ?? []);
const rest = docsData.api.filter((entry) => !featuredNames.includes(entry.name));
const entries: ApiEntry[] = [...featured, ...rest];
const OPEN_MEMBERS_LIMIT = 12;

function searchText(entry: ApiEntry) {
  const memberText = entry.members.map((member) => `${member.path} ${member.doc}`).join(' ');
  return `${entry.name} ${entry.doc} ${memberText}`.toLowerCase();
}
---
<Layout title="Extension API · Nevermind Docs">
  <section class="page-hero">
    <h1>Extension API</h1>
    <p>Every type an extension can use, generated from the same declaration file the app and the AI builder read.</p>
  </section>

  <div class="docs-layout">
    <nav class="docs-sidebar" aria-label="Docs navigation">
      <DocsNav current="api" />
      <span class="docs-sidebar__section">Reference</span>
      <input class="api-filter" type="search" placeholder="Filter the API…" aria-label="Filter the API" data-api-filter autocomplete="off" />
      <div class="api-index">
        {entries.map((entry) => (
          <a href={`#${entry.name}`} data-api-link={entry.name} data-deprecated={entry.deprecated || undefined}>{entry.name}</a>
        ))}
      </div>
    </nav>

    <article class="docs-article">
      {entries.length === 0 && <p>The API reference is being regenerated. Check back shortly.</p>}
      {docsData.intro && <div class="api-intro" data-api-intro set:html={renderDocMarkup(docsData.intro)} />}

      {entries.map((entry) => (
        <section class="api-entry" id={entry.name} data-api-entry={entry.name} data-search={searchText(entry)}>
          <h3>
            <a class="api-entry__name" href={`#${entry.name}`}><code>{entry.name}</code></a>
            {entry.deprecated && <span class="api-badge">deprecated</span>}
          </h3>
          {entry.doc && <div set:html={renderDocMarkup(entry.doc)} />}
          {entry.tags.filter((tag) => tag.name !== 'deprecated' && tag.text).map((tag) => (
            <div class="api-tag">
              <span class="api-tag__name">@{tag.name}</span>
              <div set:html={renderDocMarkup(tag.name === 'example' && !tag.text.includes('```') ? `\`\`\`\n${tag.text}\n\`\`\`` : tag.text)} />
            </div>
          ))}
          {entry.source && <pre><code>{entry.source}</code></pre>}
          {entry.members.length > 0 && (
            <details class="api-members" open={entry.members.length <= OPEN_MEMBERS_LIMIT}>
              <summary>{entry.members.length} members</summary>
              <table class="table">
                <thead><tr><th>Member</th><th>Description</th></tr></thead>
                <tbody>
                  {entry.members.map((member) => (
                    <tr data-deprecated={member.deprecated || undefined}>
                      <td>
                        <code>{member.path}</code>
                        <div class="api-signature"><code>{member.signature}</code></div>
                      </td>
                      <td set:html={member.doc ? renderDocMarkup(summarizeDoc(member.doc)) : ''}></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </details>
          )}
        </section>
      ))}
    </article>
  </div>
</Layout>

<script>
  const filter = document.querySelector<HTMLInputElement>('[data-api-filter]');
  const sections = document.querySelectorAll<HTMLElement>('[data-api-entry]');
  const links = document.querySelectorAll<HTMLElement>('[data-api-link]');

  function applyFilter() {
    const needle = (filter?.value ?? '').trim().toLowerCase();
    const visible = new Set<string>();
    for (const intro of document.querySelectorAll<HTMLElement>('[data-api-intro]')) intro.hidden = Boolean(needle);
    for (const section of sections) {
      const match = !needle || (section.dataset.search ?? '').includes(needle);
      section.hidden = !match;
      if (match) visible.add(section.dataset.apiEntry ?? '');
    }
    for (const link of links) link.hidden = !visible.has(link.dataset.apiLink ?? '');
  }

  filter?.addEventListener('input', applyFilter);
  document.addEventListener('keydown', function focusFilterOnSlash(event) {
    const typing = (event.target as HTMLElement).closest('input, textarea');
    if (event.key === '/' && !typing) {
      event.preventDefault();
      filter?.focus();
    }
  });
</script>
