---
import Layout from '../../layouts/Layout.astro';
import DocsNav from '../../components/DocsNav.astro';
import { docsData } from '../../lib/docs-data';

export const prerender = true;

---
<Layout title="Built-in features · Nevermind Docs">
  <section class="page-hero">
    <h1>Built-in features</h1>
    <p>Everything Nevermind ships with. This page is generated from the app's own extensions, so it always matches the version you download.</p>
  </section>

  <div class="docs-layout">
    <nav class="docs-sidebar" aria-label="Docs navigation">
      <DocsNav current="features" />
    </nav>

    <article class="docs-article">
      {docsData.features.length === 0 && <p>The feature list is being regenerated. Check back shortly.</p>}

      <div class="feature-grid">
        {docsData.features.map((feature) => (
          <section class="feature-card" id={feature.id.replace('nevermind.', '')}>
            <h3>{feature.title}</h3>
            {feature.description && <p class="feature-card__subtitle">{feature.description}</p>}
            {feature.commands.length > 0 && (
              <ul class="feature-card__commands">
                {feature.commands.map((command) => (
                  <li>
                    <strong>{command.title}</strong>
                    {command.subtitle && <span> · {command.subtitle}</span>}
                    {command.aliases.length > 0 && (
                      <span class="feature-card__aliases"> · try {command.aliases.slice(0, 3).map((alias) => <code>{alias}</code>)}</span>
                    )}
                  </li>
                ))}
              </ul>
            )}
            {feature.capabilities.length > 0 && (
              <p class="feature-card__capabilities">{feature.capabilities.map((capability) => <code>{capability}</code>)}</p>
            )}
          </section>
        ))}
      </div>


      <p>Want something that isn't here? <a href="/docs/api">Build your own extension</a> or ask the AI builder to do it.</p>
    </article>
  </div>
</Layout>
