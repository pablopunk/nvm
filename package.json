{
  "name": "nvm",
  "version": "0.25.0",
  "description": "Nevermind: an AI-native command palette for your desktop",
  "author": "Pablo Varela",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/install-git-hooks.cjs && node scripts/install-backend-dependencies.cjs",
    "test": "pnpm -C src/backend test",
    "test:ci-workflows": "node --test \".github/scripts/*.test.cjs\"",
    "smoke:deployed": "pnpm -C src/backend smoke:deployed",
    "verify": "pnpm check && pnpm test:ci-workflows && node scripts/run-checks.cjs && pnpm -C src/backend check && pnpm -C src/backend test",
    "check": "biome check --assist-enabled=false --skip=suspicious --skip=style --skip=a11y --skip=performance --skip=complexity",
    "check:changed": "node scripts/lint-changed.cjs",
    "check:staged": "node scripts/check-staged.cjs",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "format:staged": "node scripts/check-staged.cjs --write",
    "worktree:env:copy": "node scripts/copy-worktree-env.cjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16"
  }
}
